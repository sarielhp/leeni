#!/usr/bin/env ruby
# frozen_string_literal: true

# ==============================================================================
# tools/bump
#
# Automated version bump and release workflow for leeni:
# 1. Checks if running inside a Bubblewrap environment (aborts immediately if detected).
# 2. Validates working tree is 100% clean (aborts if uncommitted changes exist).
# 3. Runs the full quality gate (tools/gate --full).
# 4. Increments version by +0.0.1 (patch by default, or --major / --minor).
# 5. Updates lib/leeni/version.rb and leeni files.
# 6. Commits the updated version, tags the release, and pushes to remote.
# 7. Publishes GitHub release and installs updated binary to ~/bin via tools/install.
# ==============================================================================

require 'open3'
require 'optparse'
require 'tmpdir'

module VersionBumper
  GREEN  = "\e[32m"
  YELLOW = "\e[33m"
  RED    = "\e[31m"
  CYAN   = "\e[36m"
  BOLD   = "\e[1m"
  RESET  = "\e[0m"

  REPO_ROOT = File.expand_path('..', __dir__)
  VERSION_FILE = File.join(REPO_ROOT, 'lib', 'leeni', 'version.rb')
  LEENI_FILE = File.join(REPO_ROOT, 'leeni')

  def self.run!(dry_run: false, bump_type: :patch)
    check_bubblewrap!

    puts "#{BOLD}==> Version Bump Workflow (leeni)#{RESET}"

    Dir.chdir(REPO_ROOT) do
      check_git_repo!
      check_clean_working_tree!
      run_quality_gate!

      current_v = read_current_version
      new_v = compute_next_version(current_v, type: bump_type)
      puts "--> Bumping version (#{bump_type}): #{YELLOW}#{current_v}#{RESET} -> #{GREEN}#{BOLD}#{new_v}#{RESET}"

      if dry_run
        puts "#{CYAN}[Dry Run] Would update lib/leeni/version.rb, commit, tag v#{new_v}, push, and install.#{RESET}"
        return
      end

      apply_version_update(new_v)
      git_commit_and_push!(new_v)
      publish_github_release!(new_v)
      install_updated_binary!
    end
  end

  def self.check_bubblewrap!
    return unless bubblewrap_environment?

    puts "#{RED}#{BOLD}❌ Cannot bump version: running inside a Bubblewrap environment.#{RESET}"
    puts "Version bumping involves git tagging, remote pushes, GitHub release publication, and ~/bin binary installation."
    puts "These operations cannot be performed inside an isolated Bubblewrap / bws sandbox."
    puts "\nPlease run ./tools/bump directly on the host machine.\n"
    exit 1
  end

  def self.bubblewrap_environment?
    return true if ENV.key?('BWS_ACTIVE_PROFILES') || ENV.key?('BWS_SANDBOX') || ENV['BWRAP'] || ENV['container'] == 'bwrap'
    return true if File.exist?('/.flatpak-info')

    if File.file?('/proc/1/comm')
      comm = (File.read('/proc/1/comm').strip rescue nil)
      return true if comm == 'bwrap'
    end

    if File.file?('/proc/1/cmdline')
      cmdline = (File.read('/proc/1/cmdline') rescue '')
      return true if cmdline.include?('bwrap')
    end

    return true if bubblewrap_ancestor_process?
    return true if bubblewrap_mount_detected?

    false
  end

  def self.pid_is_bwrap?(pid)
    comm = (File.read("/proc/#{pid}/comm").strip rescue nil)
    return true if comm == 'bwrap'

    first_arg = (File.read("/proc/#{pid}/cmdline").split("\0").first rescue nil)
    return true if first_arg && File.basename(first_arg) == 'bwrap'

    false
  end

  def self.parent_pid_of(pid)
    status = (File.read("/proc/#{pid}/status") rescue '')
    match = status.match(/^PPid:\s+(\d+)/)
    match ? match[1].to_i : 0
  end

  def self.bubblewrap_ancestor_process?
    pid = Process.pid
    while pid && pid > 0
      return true if pid_is_bwrap?(pid)

      parent = parent_pid_of(pid)
      break if parent == pid || parent <= 0

      pid = parent
    end
    false
  rescue StandardError
    false
  end

  def self.bubblewrap_mount_detected?
    return false unless File.file?('/proc/self/mountinfo')

    mountinfo = (File.read('/proc/self/mountinfo') rescue '')
    mountinfo.include?('/.bws') || mountinfo.include?('/tmp/bws')
  rescue StandardError
    false
  end

  def self.check_git_repo!
    _out, status = Open3.capture2('git', 'rev-parse', '--is-inside-work-tree')
    return if status.success?

    puts "#{RED}❌ Error: Not inside a git repository.#{RESET}"
    exit 1
  end

  def self.check_clean_working_tree!
    stdout, status = Open3.capture2('git', 'status', '--porcelain')
    unless status.success?
      puts "#{RED}❌ Error checking git status.#{RESET}"
      exit 1
    end

    return if stdout.strip.empty?

    puts "#{RED}#{BOLD}❌ Cannot bump version: uncommitted changes detected in working tree.#{RESET}"
    puts "All modifications must be committed or stashed before bumping.\n\n"
    puts stdout
    puts "\nAborting bump."
    exit 1
  end

  def self.run_quality_gate!
    gate_script = File.join(REPO_ROOT, 'tools/gate')
    return unless File.file?(gate_script) && File.executable?(gate_script)

    puts "--> Running quality gate: #{CYAN}tools/gate#{RESET}..."
    stdout_stderr, status = Open3.capture2e(gate_script, '--full')
    return if status.success?

    puts "#{RED}❌ Quality gate failed. Aborting bump.#{RESET}"
    puts stdout_stderr
    exit 1
  end

  def self.read_current_version
    if File.file?(VERSION_FILE)
      content = File.read(VERSION_FILE)
      return Regexp.last_match(1) if content =~ /VERSION\s*=\s*['"]([^'"]+)['"]/
    end

    if File.file?(LEENI_FILE)
      content = File.read(LEENI_FILE)
      return Regexp.last_match(1) if content =~ /VERSION\s*=\s*['"]([^'"]+)['"]/
    end

    '0.1.0'
  end

  def self.compute_next_version(version_str, type: :patch)
    parts = version_str.split('.').map(&:to_i)
    while parts.size < 3
      parts << 0
    end
    major, minor, patch = parts
    case type
    when :major then "#{major + 1}.0.0"
    when :minor then "#{major}.#{minor + 1}.0"
    else             "#{major}.#{minor}.#{patch + 1}"
    end
  end

  def self.apply_version_update(new_v)
    # 1. Update lib/leeni/version.rb
    if File.file?(VERSION_FILE)
      content = File.read(VERSION_FILE)
      updated = content.sub(/VERSION\s*=\s*['"][^'"]+['"](?:\.freeze)?/, "VERSION = '#{new_v}'.freeze")
      File.write(VERSION_FILE, updated) if updated != content
      puts "  [#{GREEN}OK#{RESET}] Updated #{VERSION_FILE}"
    end

    # 2. Update leeni fallback string if present
    if File.file?(LEENI_FILE)
      content = File.read(LEENI_FILE)
      updated = content.sub(/(: '\d+\.\d+\.\d+')/, ": '#{new_v}'")
      File.write(LEENI_FILE, updated) if updated != content
      puts "  [#{GREEN}OK#{RESET}] Updated #{LEENI_FILE}"
    end
  end

  def self.git_commit_and_push!(new_v)
    puts "--> Committing version bump to git..."
    files_to_add = ['lib/leeni/version.rb', 'leeni']
    Open3.capture2('git', 'add', *files_to_add)
    commit_msg = "Bump version to #{new_v}"
    out, status = Open3.capture2e('git', 'commit', '-m', commit_msg)
    unless status.success?
      puts "#{RED}❌ Failed to commit version bump:#{RESET}\n#{out}"
      exit 1
    end

    tag_name = "v#{new_v}"
    puts "--> Creating tag #{CYAN}#{tag_name}#{RESET}..."
    out, status = Open3.capture2e('git', 'tag', '-a', tag_name, '-m', "Release #{tag_name}")
    unless status.success?
      puts "#{RED}❌ Failed to create tag #{tag_name}:#{RESET}\n#{out}"
      exit 1
    end

    puts "--> Pushing commits and tags to remote..."
    out, status = Open3.capture2e('git', 'push', '--follow-tags')
    unless status.success?
      puts "#{RED}❌ Failed to push to remote:#{RESET}\n#{out}"
      exit 1
    end

    puts "#{GREEN}#{BOLD}✅ Successfully bumped to #{new_v}, committed, tagged, and pushed!#{RESET}"
  end

  def self.publish_github_release!(new_v)
    return unless command_available?('gh') && gh_authenticated?

    tag_name = "v#{new_v}"
    puts "--> Publishing GitHub release #{CYAN}#{tag_name}#{RESET} with standalone binary..."
    Dir.mktmpdir('leeni_release') do |tmpdir|
      bundle_path = File.join(tmpdir, 'leeni')
      bundle_script = File.join(REPO_ROOT, 'tools/bundle')
      _out, status = Open3.capture2e(bundle_script, '-o', bundle_path)
      unless status.success? && File.file?(bundle_path)
        puts "#{YELLOW}⚠️ Warning: Failed to bundle standalone binary for release.#{RESET}"
        next
      end

      cmd = ['gh', 'release', 'create', tag_name, bundle_path, '--title', "Release #{tag_name}", '--generate-notes']
      out, status = Open3.capture2e(*cmd)
      if status.success?
        puts "  [#{GREEN}OK#{RESET}] GitHub release #{tag_name} published with standalone binary."
      else
        puts "#{YELLOW}⚠️ Warning: gh release create failed:#{RESET}\n#{out}"
      end
    end
  end

  def self.install_updated_binary!
    install_script = File.join(REPO_ROOT, 'tools', 'install')
    unless File.executable?(install_script)
      puts "#{YELLOW}⚠️ Warning: #{install_script} not found or not executable; skipping install.#{RESET}"
      return
    end

    puts "--> Installing updated binary to ~/bin..."
    out, status = Open3.capture2e(install_script, '-v')
    if status.success?
      puts out
    else
      puts "#{RED}❌ Error running #{install_script}:#{RESET}\n#{out}"
    end
  end

  def self.command_available?(cmd)
    ENV['PATH'].to_s.split(File::PATH_SEPARATOR).any? do |dir|
      File.executable?(File.join(dir, cmd))
    end
  end

  def self.gh_authenticated?
    _out, status = Open3.capture2e('gh', 'auth', 'status')
    status.success?
  rescue StandardError
    false
  end
end

options = {
  dry_run: false,
  bump_type: :patch
}

OptionParser.new do |opts|
  opts.banner = 'Usage: ./tools/bump [options]'
  opts.separator ''
  opts.separator 'Options:'

  opts.on('--major', 'Increment major version component (e.g. 1.0.1 -> 2.0.0)') do
    options[:bump_type] = :major
  end

  opts.on('--minor', 'Increment minor version component (e.g. 1.0.1 -> 1.1.0)') do
    options[:bump_type] = :minor
  end

  opts.on('-n', '--dry-run', 'Compute and print next version without modifying files or pushing') do
    options[:dry_run] = true
  end

  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit 0
  end
end.parse!

VersionBumper.run!(dry_run: options[:dry_run], bump_type: options[:bump_type]) if __FILE__ == $PROGRAM_NAME
