#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'optparse'
require 'tmpdir'
require 'find'
require 'open3'

PROFILE = File.expand_path('profiles/bws-latex-write.json', __dir__)
DEFAULT_LEENI = File.expand_path('../leeni', __dir__)
DEFAULT_BWS = ENV.fetch('BWS_BIN', 'bws')

def usage_error(message)
  warn "bws_run: #{message}"
  warn 'Usage: tools/bws_run SOURCE [options] -- COMMAND [ARGS...]'
  exit 2
end

def ignored_path?(path)
  ignored = %w[.git junk .bws .bws.jsonc .bws-home .leeni_bws_bin .sandbox-config]
  path.split(File::SEPARATOR).any? { |part| ignored.include?(part) }
end

def copy_source(source, destination)
  Find.find(source) do |path|
    next if path == source

    relative = path.delete_prefix("#{source}#{File::SEPARATOR}")
    Find.prune if ignored_path?(relative)
    target = File.join(destination, relative)
    stat = File.lstat(path)
    if stat.directory?
      FileUtils.mkdir_p(target)
    elsif stat.symlink?
      raise ArgumentError, "source contains symlink: #{relative}"
    elsif stat.file?
      FileUtils.mkdir_p(File.dirname(target))
      FileUtils.cp(path, target)
    else
      raise ArgumentError, "source contains a special file: #{relative}"
    end
  end
end

def writable_cache_binds(real_home, sandbox_home)
  candidates = [
    [File.join(real_home, '.texlive2026/texmf-var'), File.join(sandbox_home, '.texlive2026/texmf-var')],
    [File.join(real_home, '.texlive2026/texmf-config'), File.join(sandbox_home, '.texlive2026/texmf-config')],
    [File.join(real_home, '.local/share/fonts'), File.join(sandbox_home, '.local/share/fonts')],
    [File.join(real_home, '.cache/fontconfig'), File.join(sandbox_home, '.cache/fontconfig')]
  ]
  candidates.select { |host, _target| File.exist?(host) }
end

def write_config(workspace, real_home, sandbox_home)
  bws_dir = File.join(workspace, '.bws')
  profile_dir = File.join(bws_dir, 'profiles')
  FileUtils.mkdir_p(profile_dir)
  FileUtils.cp(PROFILE, File.join(profile_dir, File.basename(PROFILE)))
  global_dir = File.join(sandbox_home, '.config', 'bws')
  FileUtils.mkdir_p(global_dir)
  File.write(File.join(global_dir, 'config.jsonc'), "{}\n")
  config_home = File.join(workspace, '.sandbox-config')
  FileUtils.mkdir_p(config_home)
  binds = writable_cache_binds(real_home, sandbox_home)
  config = {
    'system' => { 'share_net' => false, 'clearenv' => true, 'unshare_uts' => true },
    'profiles' => ['bws-latex-write'],
    'env' => { 'HOME' => sandbox_home, 'XDG_CONFIG_HOME' => config_home },
    'path' => [File.join(workspace, '.leeni_bws_bin'), '/usr/bin', '/bin'],
    'binds_rw' => binds.map { |host, target| [host, target] },
    'binds_ro' => []
  }
  File.write(File.join(bws_dir, 'config.jsonc'), JSON.pretty_generate(config) + "\n")
end

def parse_options
  options = { output: nil, bws: DEFAULT_BWS, leeni: DEFAULT_LEENI,
              prepare_only: false, timeout: 300.0, help: false }
  parser = OptionParser.new do |opts|
    opts.banner = 'Usage: tools/bws_run SOURCE [options] -- COMMAND [ARGS...]'
    opts.on('--output DIR', 'Retain the staged workspace at DIR') { |v| options[:output] = File.expand_path(v) }
    opts.on('--bws PATH', "bws executable (default: #{DEFAULT_BWS})") { |v| options[:bws] = v }
    opts.on('--leeni PATH', 'leeni executable to stage') { |v| options[:leeni] = v }
    opts.on('--prepare-only', 'stage and print the workspace without launching bws') { options[:prepare_only] = true }
    opts.on('--timeout SECONDS', Float, 'stop the sandbox after SECONDS (default: 300)') { |v| options[:timeout] = v }
    opts.on('-h', '--help', 'show this help') { options[:help] = true }
  end
  begin
    parser.parse!(ARGV)
  rescue OptionParser::ParseError => e
    usage_error(e.message)
  end
  [options, parser]
end

def resolved_output(path)
  suffix = []
  until File.exist?(path) || File.symlink?(path)
    suffix.unshift(File.basename(path))
    path = File.dirname(path)
  end
  File.join(File.realpath(path), *suffix)
end

def validate_options(source, options)
  unless options[:timeout].finite? && options[:timeout].positive?
    raise ArgumentError,
          '--timeout must be finite and positive'
  end

  raise ArgumentError, 'source must be a paper directory, not /' if source == '/'
  if !options[:output] && source == '/tmp'
    raise ArgumentError, '--output must be outside the source directory'
  end

  options[:leeni] = File.realpath(options[:leeni])
  options[:bws] = File.expand_path(options[:bws]) if options[:bws].include?(File::SEPARATOR)
  return unless options[:output]

  output = options[:output]
  raise ArgumentError, "--output already exists: #{output}" if File.exist?(output) || File.symlink?(output)

  output = resolved_output(output)
  if output == source || output.start_with?("#{source}/")
    raise ArgumentError, '--output must be outside the source directory'
  end

  options[:output] = output
end

def stage_workspace(source, options, real_home)
  workspace = options[:output] || Dir.mktmpdir('leeni_bws_', '/tmp')
  if options[:output]
    FileUtils.mkdir_p(File.dirname(workspace))
    Dir.mkdir(workspace)
  end
  copy_source(source, workspace)
  sandbox_home = File.join(workspace, '.bws-home')
  FileUtils.mkdir_p(sandbox_home)
  write_config(workspace, real_home, sandbox_home)
  staged_latex = File.join(workspace, '.leeni_bws_bin', 'leeni')
  FileUtils.mkdir_p(File.dirname(staged_latex))
  FileUtils.cp(options[:leeni], staged_latex)
  FileUtils.chmod(0o755, staged_latex)
  vendor = File.expand_path('../vendor/revtex4', __dir__)
  staged_vendor = File.join(File.dirname(staged_latex), 'vendor', 'revtex4')
  if File.directory?(vendor)
    FileUtils.mkdir_p(File.dirname(staged_vendor))
    FileUtils.cp_r(vendor, staged_vendor)
  end
  [workspace, sandbox_home, staged_latex]
end

def launch(workspace, sandbox_home, staged_latex, options, command)
  command = [staged_latex] if command.empty?
  command[0] = staged_latex if command[0] == 'leeni'
  args = ['--no-init', '--no-ssh', '--offline', '--no-proxy', '--no-dbus', '--'] + command
  env = {
    'HOME' => sandbox_home,
    'XDG_CONFIG_HOME' => File.join(sandbox_home, '.config'),
    'PATH' => ENV.fetch('PATH', '/usr/bin:/bin'),
    'USER' => ENV['USER'], 'LOGNAME' => ENV['LOGNAME'],
    'LANG' => ENV['LANG'], 'TERM' => ENV['TERM'], 'SSH_AUTH_SOCK' => nil
  }
  File.open(File.join(workspace, 'bws-run.log'), 'w') do |log|
    Open3.popen2e(env, options[:bws], *args, chdir: workspace, unsetenv_others: true,
                                             pgroup: true) do |input, output, child|
      input.close
      reader = Thread.new do
        loop do
          chunk = output.readpartial(8192)
          log.write(chunk)
          log.flush
          $stdout.write(chunk)
          $stdout.flush
        end
      rescue IOError
        nil
      end
      status = wait_for_child(child, options[:timeout], log)
      output.close unless reader.join(2)
      reader.join
      return status
    end
  end
end

def signal_group(signal, pid)
  Process.kill(signal, -pid)
rescue Errno::ESRCH
  nil
end

def wait_for_child(child, seconds, log)
  if child.join(seconds)
    status = child.value
    return status.exitstatus || (128 + status.termsig)
  end

  signal_group('TERM', child.pid)
  child.join(2)
  signal_group('KILL', child.pid)
  child.join
  message = "bws_run: command timed out after #{seconds} seconds"
  warn message
  log.puts(message)
  124
end

def main
  options, parser = parse_options
  if options[:help]
    puts parser
    return 0
  end
  source = ARGV.shift || usage_error('source directory is required')
  raise ArgumentError, "source is not a directory: #{source}" unless File.directory?(source)

  source = File.realpath(source)
  validate_options(source, options)
  workspace, sandbox_home, staged_latex = stage_workspace(source, options, Dir.home)
  puts workspace
  $stdout.flush
  return 0 if options[:prepare_only]

  launch(workspace, sandbox_home, staged_latex, options, ARGV)
rescue ArgumentError, SystemCallError => e
  warn "bws_run: #{e.message}"
  2
end

exit main if __FILE__ == $PROGRAM_NAME
