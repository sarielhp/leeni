#!/usr/bin/env ruby
# frozen_string_literal: true

# Tiered quality gate. The default is cheap enough to run after every edit.
require 'open3'
require 'optparse'
require 'etc'

module QualityGate
  COLORS = { green: "\e[32m", red: "\e[31m", cyan: "\e[36m", bold: "\e[1m", reset: "\e[0m" }.freeze
  FAST_TESTS = %w[
    test_error_catalog.rb test_flattener.rb test_jsonc_parser.rb
    test_brace_checker.rb test_author_names.rb test_compile_format.rb
    test_diagnostic_record.rb test_presenters.rb
    test_log_recognisers.rb test_deep_diagnostics.rb test_diagnostic_formatting.rb
    test_repair_failures.rb test_config.rb test_color_theme.rb
    test_author_verification.rb test_visual_verification.rb test_compatibility.rb
    test_arxiv_worker.rb test_arxiv_fixups.rb test_sample_arxiv.rb test_bump.rb
  ].freeze
  MEDIUM_TESTS = %w[
    test_compile_mode.rb test_pathological_latex.rb test_llm_mode.rb test_json_mode.rb
    test_bib_integration.rb test_bws_review.rb test_bib_extractor.rb
    test_raw_mode.rb test_metadata_report_review.rb test_arxiv_runner_review.rb
    test_build_cache.rb test_vim_integration.rb test_destructive_paths.rb
    test_arxiv.rb test_config_save.rb test_code_metrics.rb test_convergence_loop.rb
    test_sample_arxiv_review.rb test_arxiv_cycle.rb test_emacs_auctex.rb
  ].freeze
  FULL_TESTS = %w[
    test_latex_it.rb
  ].freeze
  TIERS = { fast: FAST_TESTS, medium: MEDIUM_TESTS + FAST_TESTS,
            full: FULL_TESTS + MEDIUM_TESTS + FAST_TESTS }.freeze

  def self.run!(tier)
    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    root = File.expand_path('..', __dir__)
    Dir.chdir(root) do
      announce(tier)
      check_syntax!
      run_tests!(TIERS.fetch(tier))
    end
    elapsed = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round(2)
    puts color(:green, "#{color(:bold, 'All')} #{tier} quality gate checks passed in #{elapsed}s!")
  rescue KeyError
    abort 'gate: unknown tier'
  end

  def self.announce(tier)
    puts color(:bold, "==> Running #{tier.capitalize} Quality Gate (latex_it)...")
  end

  def self.check_syntax!
    puts "--> #{color(:cyan, '[1/3]')} Ruby syntax and warnings (ruby -cw)..."
    files = ['latex_it'] + Dir.glob('lib/**/*.rb') + Dir.glob('tools/*').select { |path| ruby_script?(path) } + Dir.glob('test/**/*.rb')
    output, status = Open3.capture2e('ruby', '-cw', *files.uniq)
    abort_failure('Syntax check or compiler warning failed', output) unless status.success? && !output.include?('warning:')

    check_lint!
  end

  def self.check_lint!
    puts "--> #{color(:cyan, '[2/3]')} Static analysis and correctness (rubocop)..."
    output, status = Open3.capture2e('rubocop')
    return if status.success?

    abort_failure('RuboCop static analysis failed', output)
  rescue Errno::ENOENT
    abort_failure('RuboCop is not installed', 'Run tools/setup_ruby_dev to install the development dependencies.')
  end

  def self.run_tests!(files)
    puts "--> #{color(:cyan, '[3/3]')} #{files.length} test files (with -w)..."
    queue = Queue.new
    # Queue longest-running tests first to optimize thread pool utilization
    files.each { |name| queue << name }
    failures = []
    mutex = Mutex.new
    max_workers = (Etc.nprocessors rescue 4)
    worker_count = [max_workers, files.length].min
    threads = worker_count.times.map do
      Thread.new do
        while (name = (queue.pop(true) rescue nil))
          file = File.join('test', name)
          output, status = run_test(file)
          has_warning = output.lines.any? { |line| line.include?('warning:') }
          mutex.synchronize { failures << [file, output] } if !status.success? || has_warning
        end
      end
    end
    threads.each(&:join)
    return if failures.empty?

    failures.each { |file, output| warn color(:red, "❌ Failure or warning in #{file}:\n") + output }
    exit 1
  end

  def self.run_test(file)
    Open3.capture2e('ruby', '-w', '-I.', file)
  end

  def self.ruby_script?(path)
    File.file?(path) && (File.extname(path) == '.rb' || File.open(path, &:gets).to_s.start_with?('#!/usr/bin/env ruby'))
  end

  def self.abort_failure(label, output)
    warn color(:red, "❌ #{label}:")
    warn output
    exit 1
  end

  def self.color(name, text)
    "#{COLORS.fetch(name)}#{text}#{COLORS[:reset]}"
  end
end

options = { tier: :fast }
OptionParser.new do |opts|
  opts.banner = 'Usage: tools/gate [--fast|--medium|--full]'
  opts.on('--fast', 'syntax and deterministic unit tests (default)') { options[:tier] = :fast }
  opts.on('--medium', 'fast checks plus practical real-LaTeX integration tests') { options[:tier] = :medium }
  opts.on('--full', 'medium checks plus long integration, BWS, visual, and corpus checks') { options[:tier] = :full }
  opts.on('-h', '--help', 'show this help') { puts opts; exit }
end.parse!
abort "gate: unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
QualityGate.run!(options[:tier])
