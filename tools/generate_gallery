  def self.escape_xml(str)
    str.to_s.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;').gsub('"', '&quot;')
  end

  def self.parse_ansi_line(raw)
    tokens = []
    cur_color = '#c0caf5'
    cur_bold = false
    scanner = StringScanner.new(raw.rstrip)

    until scanner.eos?
      if (match = scanner.scan(/\e\[([0-9;]+)m/))
        match[2..-2].split(';').each do |c|
          if c == '0'
            cur_color = '#c0caf5'
            cur_bold = false
          elsif c == '1'
            cur_bold = true
          elsif COLOR_MAP[c]
            cur_color = COLOR_MAP[c]
          end
        end
      elsif (chunk = scanner.scan(/[^\e]+/))
        tokens << { text: chunk, color: cur_color, bold: cur_bold }
      else
        tokens << { text: scanner.getch, color: cur_color, bold: cur_bold }
      end
    end

    tokens.empty? ? [{ text: '', color: '#c0caf5', bold: false }] : tokens
  end

  def self.parse_plain_line(raw)
    l = raw.rstrip
    color = '#c0caf5'
    bold = false

    if l.start_with?('$')
      color = '#7dcfff'
      bold = true
    elsif l =~ /\A(?:<<< DELETED \d+ LINES? >>>|<deleted \d+ lines?>)/i
      return [{ text: l, color: '#e0af68', bold: true, font_size: '15.5px' }]
    elsif l =~ /\A(?:!|Collected error summary)/i
      color = '#ff6b6b'
      bold = true
    elsif l =~ /\A(?:Latexmk:|Rule |Category |Rc files|Running |Changed files)/
      color = '#565f89'
    elsif l =~ /\A(?:Runaway argument\?|Important warning)/i
      color = '#ff9e64'
      bold = true
    end

    [{ text: l, color: color, bold: bold }]
  end

  def self.wrap_tokens(tokens, max_chars = 68)
    lines = [[]]
    cur_len = 0

    tokens.each do |tok|
      text = tok[:text]
      while cur_len + text.length > max_chars && text.include?(' ')
        avail = max_chars - cur_len
        split_idx = text[0..avail].rindex(' ') || text.index(' ')
        break unless split_idx && split_idx > 0

        lines.last << tok.merge(text: text[0...split_idx])
        lines << [{ text: '    ', color: tok[:color], bold: false }]
        cur_len = 4
        text = text[(split_idx + 1)..]
      end
      lines.last << tok.merge(text: text)
      cur_len += text.length
    end
    lines
  end

  def self.build_display_lines(raw_lines, is_ansi: false)
    wrapped = []
    raw_lines.each do |raw|
      tokens = is_ansi ? parse_ansi_line(raw) : parse_plain_line(raw)
      wrap_tokens(tokens).each { |wl| wrapped << wl }
    end
    wrapped
  end

  def self.render_panel(title, lines, pill, is_left, panel_w, panel_h, line_h)
    x_offset = is_left ? 24 : (1240 - panel_w - 24)
    stroke_color = is_left ? '#2f334d' : '#384a68'
    title_color = is_left ? '#787c99' : '#c0caf5'
    dot_color = is_left ? '#414868' : '#9ece6a'
    pill_bg = is_left ? '#2d1c24' : '#1c2d24'
    pill_fg = is_left ? '#ff6b6b' : '#9ece6a'

    rendered_lines = lines.map.with_index do |line_toks, i|
      spans = line_toks.map do |t|
        extra = ''
        extra += ' font-weight="bold"' if t[:bold]
        extra += ' font-style="italic"' if t[:italic]
        extra += %( font-size="#{t[:font_size]}") if t[:font_size]
        %(<tspan fill="#{t[:color]}"#{extra}>#{escape_xml(t[:text])}</tspan>)
      end.join
      %(<text x="0" y="#{i * line_h}">#{spans}</text>)
    end.join("\n        ")

    <<~PANEL
      <g transform="translate(#{x_offset}, 20)" filter="url(#shadow)">
        <rect width="#{panel_w}" height="#{panel_h}" rx="10" fill="#1a1b26" stroke="#{stroke_color}" stroke-width="1.5"/>
        <path d="M 0,10 A 10,10 0 0,1 10,0 L #{panel_w - 10},0 A 10,10 0 0,1 #{panel_w},10 L #{panel_w},40 L 0,40 Z" fill="#16161e"/>
        <circle cx="20" cy="20" r="6" fill="#ff6b6b"/>
        <circle cx="38" cy="20" r="6" fill="#e0af68"/>
        <circle cx="56" cy="20" r="6" fill="#{dot_color}"/>
        <text x="#{panel_w / 2}" y="25" fill="#{title_color}" text-anchor="middle" class="title">#{escape_xml(title)}</text>
        <g transform="translate(18, 62)" class="code">
          #{rendered_lines}
        </g>
        <g transform="translate(18, #{panel_h - 42})">
          <rect width="#{panel_w - 36}" height="32" rx="6" fill="#{pill_bg}" stroke="#{pill_fg}" stroke-width="1.2"/>
          <text x="#{(panel_w - 36) / 2}" y="20" fill="#{pill_fg}" text-anchor="middle" class="badge">#{escape_xml(pill)}</text>
        </g>
      </g>
    PANEL
  end

  def self.render_svg_card(left_raw, right_raw, left_pill:, right_pill:)
    left_lines = build_display_lines(left_raw, is_ansi: false)
    right_lines = build_display_lines(right_raw, is_ansi: true)

    max_count = [left_lines.size, right_lines.size].max
    line_h = 20
    panel_h = (max_count * line_h) + 20 + 46 + 48
    total_w = 1240
    total_h = panel_h + 40
    panel_w = 576

    left_panel = render_panel('Standard Tool: latexmk', left_lines, left_pill, true, panel_w, panel_h, line_h)
    right_panel = render_panel('leeni (l)', right_lines, right_pill, false, panel_w, panel_h, line_h)

    <<~SVG
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 #{total_w} #{total_h}" width="#{total_w}" height="#{total_h}">
        <defs>
          <style>
            .code { font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace; font-size: 12.5px; line-height: #{line_h}px; }
            .title { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-size: 13.5px; font-weight: 600; }
            .badge { font-family: ui-monospace, monospace; font-size: 11.5px; font-weight: 700; }
          </style>
          <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
            <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.45"/>
          </filter>
        </defs>
        <rect width="#{total_w}" height="#{total_h}" rx="14" fill="#13141c"/>
        #{left_panel}
        #{right_panel}
      </svg>
    SVG
  end

  def self.truncate_latexmk(lines, target_count)
    cleaned = lines.reject { |l| l =~ /\Acp: cannot stat/ || l =~ /\ARunning 'cp / || l =~ /\A-+\z/ }
    cleaned.pop while cleaned.last&.strip&.empty?
    return cleaned if cleaned.size <= target_count

    cmd_line = cleaned.first
    rest = cleaned[1..]
    err_idx = rest.index { |l| l =~ /\A!\s+/ || l =~ /\ARunaway argument\?/ || l =~ /\ALaTeX Error:/i }
    summary_idx = rest.rindex { |l| l =~ /Collected error summary/ }

    start_idx, end_idx = initial_window_bounds(rest, target_count, err_idx, summary_idx)
    fit_window_to_target(cmd_line, rest, start_idx, end_idx, target_count, err_idx, summary_idx)
  end

  def self.format_deleted(count)
    unit = count == 1 ? 'LINE' : 'LINES'
    "<<< DELETED #{count} #{unit} >>>"
  end

  def self.initial_window_bounds(rest, target_count, err_idx, summary_idx)
    needed = [target_count - 2, 4].max
    if err_idx
      end_idx = summary_idx ? [summary_idx + 2, rest.size - 1].min : (rest.size - 1)
      start_idx = end_idx - needed + 1
      if start_idx > [err_idx - 1, 0].max
        start_idx = [err_idx - 1, 0].max
        end_idx = [start_idx + needed - 1, rest.size - 1].min
      elsif start_idx < 0
        start_idx = 0
        end_idx = [needed - 1, rest.size - 1].min
      end
    else
      end_idx = rest.size - 1
      start_idx = [end_idx - needed + 1, 0].max
    end
    [start_idx, end_idx]
  end

  def self.fit_window_to_target(cmd_line, rest, start_idx, end_idx, target_count, err_idx, summary_idx)
    slice = rest[start_idx..end_idx]
    res = assemble_truncated(cmd_line, start_idx, slice)
    disp = build_display_lines(res, is_ansi: false)

    while disp.size > target_count && slice.size > 4
      if start_idx < (err_idx ? err_idx - 1 : rest.size)
        start_idx += 1
      elsif end_idx > (summary_idx ? summary_idx + 1 : 0)
        end_idx -= 1
      else
        break
      end
      slice = rest[start_idx..end_idx]
      res = assemble_truncated(cmd_line, start_idx, slice)
      disp = build_display_lines(res, is_ansi: false)
    end
    res
  end

  def self.assemble_truncated(cmd_line, skipped, slice)
    res = [cmd_line]
    res << format_deleted(skipped) if skipped > 0
    res.concat(slice)
    res
  end

  def self.compile_scenario(scenario)
    Dir.mktmpdir('gallery_case') do |dir|
      tex_file = File.join(dir, 'paper.tex')
      File.write(tex_file, scenario[:tex])
      scenario[:files]&.each do |fname, content|
        File.write(File.join(dir, fname), content)
      end

      out_mk, _ = Open3.capture2e('latexmk', '-xelatex', '-halt-on-error', 'paper.tex', chdir: dir)
      out_l, _ = Open3.capture2e({ 'CLICOLOR_FORCE' => '1' }, LEENI, '--no-lock', '-f', 'paper.tex', chdir: dir)

      right_raw = ['$ l paper.tex'] + out_l.lines.map(&:chomp)
      right_display = build_display_lines(right_raw, is_ansi: true)

      left_raw = ['$ latexmk -xelatex paper.tex'] + out_mk.lines.map(&:chomp)
      left_truncated = truncate_latexmk(left_raw, right_display.size)
      [left_truncated, right_raw]
    end
  end

  def self.render_scenario_assets(scenario)
    puts "  ==> Executing genuine compilation for #{scenario[:id]}..."
    left_raw, right_raw = compile_scenario(scenario)

    svg_content = render_svg_card(
      left_raw, right_raw,
      left_pill: scenario[:left_pill],
      right_pill: scenario[:right_pill]
    )

    svg_path = File.join(IMAGES_DIR, "#{scenario[:filename]}.svg")
    File.write(svg_path, svg_content)
    puts "      Wrote #{svg_path}"

    png_path = File.join(IMAGES_DIR, "#{scenario[:filename]}.png")
    if system('which', 'rsvg-convert', out: File::NULL, err: File::NULL)
      system('rsvg-convert', '-o', png_path, svg_path)
    elsif system('which', 'convert', out: File::NULL, err: File::NULL)
      system('convert', '-density', '150', svg_path, png_path)
    end
    puts "      Wrote #{png_path}" if File.exist?(png_path)
  end

  def self.build_markdown_content(image_prefix: 'images/')
    sections = SCENARIOS.map do |s|
      files_block = if s[:files]
                      "\n" + s[:files].map do |fname, fcontent|
                        lang = fname.end_with?('.bib') ? 'bibtex' : 'latex'
                        "**Companion `#{fname}`:**\n```#{lang}\n#{fcontent.strip}\n```\n"
                      end.join("\n")
                    else
                      ''
                    end

      <<~SECTION
        ## #{s[:title]}

        **Problem Scenario:**
        #{s[:problem]}

        ```latex
        #{s[:tex].strip}
        ```
        #{files_block}
        ![#{s[:title]}](#{image_prefix}#{s[:filename]}.svg)

        ### Commentary & Diagnosis

        - **Standard Tool (`latexmk` / `xelatex`)**: #{s[:standard_fails]}
        - **`leeni` Resolution**: #{s[:leeni_wins]}

        ---
      SECTION
    end

    <<~MARKDOWN
      ---
      layout: default
      title: Diagnostic Showcase Gallery
      permalink: /gallery.html
      redirect_from:
        - /docs/gallery.html
        - /docs/gallery.md
      ---

      # Diagnostic Showcase Gallery

      This gallery presents **unedited, real-world terminal runs** comparing standard LaTeX compilation tools (`latexmk` on `xelatex`) directly against `leeni`.

      Every comparison below was generated by running genuine compilations of both tools on the exact same `.tex` source files.

      ---

      #{sections.join("\n")}
    MARKDOWN
  end

  def self.run
    FileUtils.mkdir_p(IMAGES_DIR)
    puts '==> Generating Diagnostic Showcase Gallery from real compiler runs...'

    SCENARIOS.each { |s| render_scenario_assets(s) }

    md_content = build_markdown_content(image_prefix: 'images/')
    File.write(GALLERY_MD, md_content)
    puts "==> Wrote #{GALLERY_MD}"

    gallery_dir = File.join(DOCS_DIR, 'gallery')
    FileUtils.mkdir_p(gallery_dir)
    File.write(File.join(gallery_dir, 'README.md'), build_markdown_content(image_prefix: '../images/'))
    puts "==> Wrote #{File.join(gallery_dir, 'README.md')}"
  end
end

GalleryGenerator.run if $PROGRAM_NAME == __FILE__
