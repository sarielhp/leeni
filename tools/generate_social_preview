          <stop offset="45%" stop-color="#4facfe" />
          <stop offset="75%" stop-color="#f093fb" />
          <stop offset="100%" stop-color="#f5576c" />
        </linearGradient>

        <linearGradient id="card-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#4facfe" stop-opacity="0.6" />
          <stop offset="50%" stop-color="#3b4261" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#f5576c" stop-opacity="0.6" />
