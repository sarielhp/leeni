#!/usr/bin/env ruby
# frozen_string_literal: true

# ==============================================================================
# tools/generate_social_preview
#
# Generates a 1280x640 OpenGraph social preview image (SVG and PNG)
# for the GitHub repository settings (Settings -> General -> Social Preview).
# ==============================================================================

require 'fileutils'
require 'open3'

module SocialPreviewGenerator
  OUTPUT_DIR = File.expand_path('../docs/images', __dir__)
  SVG_PATH   = File.join(OUTPUT_DIR, 'social_preview.svg')
  PNG_PATH   = File.join(OUTPUT_DIR, 'social_preview.png')

  WIDTH  = 1280
  HEIGHT = 640

  def self.run!
    FileUtils.mkdir_p(OUTPUT_DIR)
    svg_content = build_svg
    File.write(SVG_PATH, svg_content)
    puts "--> Wrote #{SVG_PATH}"

    convert_to_png(SVG_PATH, PNG_PATH)
  end

  def self.convert_to_png(svg_path, png_path)
    if system('which', 'rsvg-convert', out: File::NULL, err: File::NULL)
      cmd = ['rsvg-convert', '-w', WIDTH.to_s, '-h', HEIGHT.to_s, svg_path, '-o', png_path]
      _out, status = Open3.capture2e(*cmd)
      if status.success? && File.file?(png_path)
        size_kb = (File.size(png_path) / 1024.0).round(1)
        puts "✔ Generated high-resolution social preview: #{png_path} (#{size_kb} KB)"
        return
      end
    end

    if system('which', 'convert', out: File::NULL, err: File::NULL)
      cmd = ['convert', '-density', '150', '-resize', "#{WIDTH}x#{HEIGHT}!", svg_path, png_path]
      _out, status = Open3.capture2e(*cmd)
      if status.success? && File.file?(png_path)
        size_kb = (File.size(png_path) / 1024.0).round(1)
        puts "✔ Generated social preview using ImageMagick: #{png_path} (#{size_kb} KB)"
        return
      end
    end

    warn 'Warning: neither rsvg-convert nor convert found to render PNG from SVG.'
  end

  def self.build_svg
    <<~SVG
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 #{WIDTH} #{HEIGHT}" width="#{WIDTH}" height="#{HEIGHT}">
        #{defs_svg}
        #{background_svg}
        #{left_column_svg}
        #{terminal_card_svg}
      </svg>
    SVG
  end

