#!/usr/bin/env ruby
# frozen_string_literal: true

# ==============================================================================
# tools/install
#
# Copies leeni to ~/bin/ and creates symbolic link ~/bin/l -> leeni.
# Usage: ./tools/install
# ==============================================================================

require 'fileutils'
require 'open3'
require 'optparse'
load File.expand_path('bundle', __dir__)

module Installer
  REPO_ROOT   = File.expand_path('..', __dir__)
  SRC_BIN     = File.join(REPO_ROOT, 'leeni')
  TARGET_DIR  = File.expand_path('~/bin')
  TARGET_BIN  = File.join(TARGET_DIR, 'leeni')
  SHORTCUTS   = %w[l lw ll lp clean_latex latex_file_in_dir].freeze
  TARGET_LINK = File.join(TARGET_DIR, 'l')
  TEXMF_SOURCE = File.join(REPO_ROOT, 'vendor', 'revtex4')
  TEXMF_TARGET = File.expand_path('~/.local/share/leeni/texmf')

  def self.run!(verbose: false)
    verify_source!
    FileUtils.mkdir_p(TARGET_DIR)

    puts "==> Installing standalone leeni bundle to #{TARGET_DIR}..." if verbose
    LatexBundler.write_bundle(TARGET_BIN, verbose: verbose)

    create_symlinks!
    install_texmf!

    if verbose
      verify_verbose!
    else
      puts "Program installed: ~/bin/leeni, ~/bin/l (shortcuts: #{SHORTCUTS[1..].join(', ')})."
    end
  end

  def self.create_symlinks!
    Dir.chdir(TARGET_DIR) do
      SHORTCUTS.each do |name|
        FileUtils.rm_f(name) if File.exist?(name) || File.symlink?(name)
        FileUtils.ln_s('leeni', name)
      end
    end
  end

  def self.install_texmf!
    source = File.join(TEXMF_SOURCE, 'tex')
    unless File.directory?(source)
      warn "Error: Compatibility files not found at: #{source}"
      exit 1
    end

    FileUtils.mkdir_p(TEXMF_TARGET)
    FileUtils.cp_r(source, TEXMF_TARGET)
    FileUtils.cp(File.join(TEXMF_SOURCE, 'README.md'), TEXMF_TARGET)
  end

  def self.verify_source!
    return if File.file?(SRC_BIN)

    warn "Error: Source executable not found at: #{SRC_BIN}"
    exit 1
  end

  def self.verify_verbose!
    in_path = ENV['PATH'].to_s.split(File::PATH_SEPARATOR).include?(TARGET_DIR)
    if in_path
      puts "  [OK] #{TARGET_DIR} is in PATH."
    else
      warn "  [WARN] #{TARGET_DIR} is NOT in PATH. Add export PATH=\"$HOME/bin:$PATH\" to your shell profile."
    end

    version_out, status = Open3.capture2(TARGET_LINK, '-V')
    if status.success?
      puts "  [OK] Verified executable: #{version_out.strip}"
    else
      warn "  [FAIL] Failed to execute #{TARGET_LINK}"
    end
    puts 'Program installed: ~/bin/leeni, ~/bin/l.'
  end
end

options = { verbose: false }
OptionParser.new do |opts|
  opts.banner = 'Usage: ./tools/install [options]'
  opts.on('-v', '--verbose', 'Show detailed installation and path status') { options[:verbose] = true }
  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit 0
  end
end.parse!

Installer.run!(verbose: options[:verbose]) if __FILE__ == $PROGRAM_NAME
