#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'optparse'
require_relative 'tooling'

module LeeniInstaller
  SHORTCUTS = %w[l lw ll lp clean_latex latex_file_in_dir].freeze
  TEXMF_SOURCE = File.expand_path('../vendor/revtex4', __dir__)
  TEXMF_TARGET = File.expand_path('~/.local/share/leeni/texmf')

  module_function

  def run(verbose: false)
    check_shortcuts
    raise "compatibility files missing: #{TEXMF_SOURCE}/tex" unless File.directory?(File.join(TEXMF_SOURCE, 'tex'))

    Tooling.install
    install_shortcuts
    install_texmf
    puts "Program installed: #{ToolSettings::INSTALL_TARGETS.fetch('build/leeni')}"
    puts "Shortcuts: #{SHORTCUTS.join(', ')}" if verbose
  end

  def install_shortcuts
    binary = ToolSettings::INSTALL_TARGETS.fetch('build/leeni')
    SHORTCUTS.each do |name|
      path = File.join(File.dirname(binary), name)
      FileUtils.ln_s('leeni', path) unless File.symlink?(path)
      raise "shortcut verification failed: #{path}" unless File.realpath(path) == File.realpath(binary)
    end
  end

  def check_shortcuts
    binary = ToolSettings::INSTALL_TARGETS.fetch('build/leeni')
    SHORTCUTS.each do |name|
      path = File.join(File.dirname(binary), name)
      raise "shortcut points elsewhere: #{path}" if File.symlink?(path) && File.readlink(path) != 'leeni'
      raise "shortcut is an unrelated file: #{path}" if File.exist?(path) && !File.symlink?(path)
    end
  end

  def install_texmf
    source = File.join(TEXMF_SOURCE, 'tex')
    raise "compatibility files missing: #{source}" unless File.directory?(source)

    FileUtils.mkdir_p(TEXMF_TARGET)
    FileUtils.cp_r(source, TEXMF_TARGET)
    FileUtils.cp(File.join(TEXMF_SOURCE, 'README.md'), TEXMF_TARGET)
    Dir.glob(File.join(TEXMF_SOURCE, '**', '*')).select { |path| File.file?(path) }.each do |path|
      target = File.join(TEXMF_TARGET, path.delete_prefix("#{TEXMF_SOURCE}/"))
      raise "compatibility file mismatch: #{target}" unless File.binread(path) == File.binread(target)
    end
  end
end

if __FILE__ == $PROGRAM_NAME
  Tooling.entry do
    options = { verbose: false }
    OptionParser.new do |parser|
      parser.banner = 'Usage: tools/install [-v]'
      parser.on('-v', '--verbose', 'Show installed shortcuts') { options[:verbose] = true }
      parser.on('-h', '--help', 'Show this help') do
        puts parser
        exit 0
      end
    end.parse!
    abort 'Usage: tools/install [-v]' unless ARGV.empty?

    LeeniInstaller.run(**options)
  end
end
