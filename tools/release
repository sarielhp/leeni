#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'tooling'

Tooling.entry do
  install_requested = ARGV.first != '--no-install'
  ARGV.shift if %w[--no-install --install].include?(ARGV.first)
  abort 'Usage: tools/release <message>' unless ARGV.length == 1 && !ARGV.first.strip.empty?
  Tooling.release(ARGV.first, install_requested: install_requested)
end
