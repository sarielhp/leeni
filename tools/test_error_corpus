#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the error-corpus expectations (test/test_error_corpus.rb), or drafts
# expected.json for a new docs/errors case.
require 'json'
require 'open3'
require 'fileutils'
require_relative 'settings'
require_relative 'tmp_space'

ProjectTmp.project = ToolSettings::PROJECT_NAME

ROOT = File.expand_path('..', __dir__)

HELP = <<~TEXT
  Usage: tools/test_error_corpus [--draft CASE_DIR]

  Without options, run test/test_error_corpus.rb: every docs/errors case must
  report exactly the diagnostics in its expected.json, and the clean documents
  in test/corpus/clean must report none.

  --draft CASE_DIR  Build CASE_DIR/example.tex in a scratch copy and print the
                    current diagnostics in expected.json form. The draft is a
                    snapshot, not an expectation: check every location and
                    category against the source before saving it.
  -h, --help        Show this help; nothing is run.
TEXT

def draft(dir)
  abort "#{dir}: no example.tex" unless File.file?(File.join(dir, 'example.tex'))
  ProjectTmp.mktmpdir('corpus-draft') do |tmp|
    work = File.join(tmp, File.basename(dir))
    FileUtils.cp_r(dir, work)
    out, = Open3.capture2(File.join(ROOT, 'leeni'), '--no-lock', '--json', 'example.tex', chdir: work)
    data = JSON.parse(out)
    diags = data['diagnostics'].map do |d|
      h = { 'file' => d['file'].start_with?('/') ? "<texmf>/#{File.basename(d['file'])}" : d['file'], 'line' => d['line'] }
      h['col'] = d['col'] if d['col']
      h.merge('tier' => d['tier'], 'category' => d['category'])
    end
    puts JSON.pretty_generate('engine' => data.dig('build', 'engine'), 'diagnostics' => diags)
  end
end

case ARGV
in [] then exec(RbConfig.ruby, '-w', File.join(ROOT, 'test', 'test_error_corpus.rb'))
in ['-h' | '--help'] then puts HELP
in ['--draft', dir] then draft(File.expand_path(dir))
else abort HELP
end
