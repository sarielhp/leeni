#!/usr/bin/env ruby
# frozen_string_literal: true

# Real failing documents from TeX Stack Exchange. Questions are fetched from
# the public API, their complete documents extracted and compiled once with
# the engine each needs (pdflatex unless fontspec and the like ask for XeTeX
# or LuaTeX); those that still fail, for a reason other than a missing
# file, are run through leeni in batches and its first error compared with
# TeX's. There is no known fault line, so differences are listed for review,
# not scored. Datasets stay outside the repository (datasets/ is ignored).
require 'json'
require 'cgi'
require 'fileutils'
require 'net/http'
require 'optparse'
require 'open3'
load File.expand_path('mutate_corpus', __dir__) unless defined?(MutateCorpus)

module TexseCorpus
  API = 'https://api.stackexchange.com/2.3/search/advanced'
  MISSING = /File `[^']*' not found|Cannot find image|could not locate the file|Unable to load picture/i
  TEX_ERROR = /^(?:! |\S+:\d+: )/

  HELP = <<~TEXT
    Usage: tools/texse_corpus COMMAND [options] DATASET_DIR

    Commands:
      fetch     download questions, top-voted first, into DATASET_DIR/download
      prepare   extract complete documents, compile new ones once with their engine,
                and write the next batch of still-failing ones (corpus/batch-N.json)
      run       run leeni (with the engine the document needs) on a batch, compare its first error with
                TeX's, and list the documents where they differ

    Options:
      -t, --tag TAG        fetch: questions with this tag (default errors)
      -q, --title TEXT     fetch: and with this text in the title
      -p, --pages A-B      fetch: result pages of 100 questions (default 1-3)
      -n, --limit N        prepare: batch size (default 50)
      -b, --batch FILE     run: ids to run (default: the newest batch)
      -o, --output FILE    run: results JSON (default: DATASET_DIR/run-<batch>.json)
      -j, --jobs N         parallel builds (default 4)
      -h, --help           show this help; nothing is run
  TEXT

  module_function

  def parse(argv)
    opts = { tag: 'errors', title: nil, pages: 1..3, limit: 50, batch: nil, output: nil, jobs: 4, timeout: 120 }
    OptionParser.new do |o|
      o.on('-t', '--tag TAG') { |v| opts[:tag] = v }
      o.on('-q', '--title TEXT') { |v| opts[:title] = v }
      o.on('-p', '--pages A-B') { |v| opts[:pages] = Range.new(*v.split('-', 2).map(&:to_i).then { |a, b| [a, b || a] }) }
      o.on('-n', '--limit N', Integer) { |v| opts[:limit] = v }
      o.on('-b', '--batch FILE') { |v| opts[:batch] = v }
      o.on('-o', '--output FILE') { |v| opts[:output] = v }
      o.on('-j', '--jobs N', Integer) { |v| opts[:jobs] = v }
      o.on('-h', '--help') do
        puts HELP
        exit
      end
    end.parse!(argv)
    opts
  end

  def each_parallel(items, jobs, &)
    queue = Queue.new
    items.each { |item| queue << item }
    Array.new([jobs, items.size].min) do
      Thread.new do
        while (item = CorpusCompare.next_entry(queue))
          yield item
        end
      end
    end.each(&:join)
  end

  def corpus_dir(root) = File.join(root, 'corpus')
  def entry_path(root, id) = File.join(corpus_dir(root), id, 'entry.json')
  def read_entry(root, id) = JSON.parse(File.read(entry_path(root, id)))

  def read_json(path, default) = File.file?(path) ? JSON.parse(File.read(path)) : default

  # --- fetch ---------------------------------------------------------------

  def fetch(root, opts)
    FileUtils.mkdir_p(File.join(root, 'download'))
    stem = [opts[:tag], opts[:title]&.downcase&.gsub(/\W+/, '_')].compact.join('-')
    opts[:pages].each do |page|
      data = fetch_page(page, opts)
      File.write(File.join(root, 'download', "#{stem}-p#{page}.json"), JSON.generate(data))
      puts "page #{page}: #{data['items'].size} questions (quota left #{data['quota_remaining']})"
      sleep(data['backoff'].to_i) if data['backoff']
      break unless data['has_more']
    end
  end

  def fetch_page(page, opts)
    query = { order: 'desc', sort: 'votes', tagged: opts[:tag], site: 'tex', pagesize: 100, page: page,
              filter: 'withbody' }
    query[:title] = opts[:title] if opts[:title]
    uri = URI(API)
    uri.query = URI.encode_www_form(query)
    response = Net::HTTP.get_response(uri, { 'User-Agent' => 'corpus-fetch' })
    abort "texse_corpus: #{uri} answered #{response.code}" unless response.is_a?(Net::HTTPSuccess)

    JSON.parse(response.body)
  end

  # --- prepare -------------------------------------------------------------

  def prepare(root, opts)
    added = extract(root)
    compiled = compile_new(root, opts)
    batch = next_batch(root, opts[:limit])
    puts "#{added} new documents, #{compiled} compiled; next batch: #{batch[:ids].size} in #{batch[:path]}"
  end

  def extract(root)
    questions = Dir.glob(File.join(root, 'download', '*.json')).flat_map { |f| JSON.parse(File.read(f))['items'] }
    questions.uniq { |q| q['question_id'] }.count do |question|
      doc = complete_document(question['body'])
      dir = File.join(corpus_dir(root), question['question_id'].to_s)
      next false unless doc && !File.directory?(dir)

      write_document(dir, doc, question)
      true
    end
  end

  def complete_document(body)
    blocks = body.to_s.scan(%r{<pre[^>]*><code>(.*?)</code></pre>}m).map { |(code)| CGI.unescapeHTML(code) }
    blocks.find { |code| code.include?('\documentclass') && code.include?('\end{document}') }
  end

  def write_document(dir, doc, question)
    FileUtils.mkdir_p(File.join(dir, 'paper'))
    File.write(File.join(dir, 'paper', 'main.tex'), doc.end_with?("\n") ? doc : "#{doc}\n")
    entry = { 'main' => 'main.tex', 'engine' => 'pdflatex', 'source' => 'tex.stackexchange', 'license' => 'CC BY-SA',
              'question_id' => question['question_id'], 'title' => CGI.unescapeHTML(question['title'].to_s),
              'link' => question['link'], 'score' => question['score'], 'tags' => question['tags'] }
    File.write(File.join(dir, 'entry.json'), JSON.pretty_generate(entry))
  end

  def compile_new(root, opts)
    # A document is compiled again when the engine it needs has changed.
    ids = Dir.children(corpus_dir(root)).grep(/\A\d+\z/).reject do |id|
      entry = read_entry(root, id)
      entry.key?('tex_errors') && entry['engine'] == engine_for(File.join(corpus_dir(root), id, 'paper')).first
    end
    lock = Mutex.new
    each_parallel(ids, opts[:jobs]) do |id|
      paper = File.join(corpus_dir(root), id, 'paper')
      errors = tex_errors(paper)
      update = { 'tex_errors' => errors, 'engine' => engine_for(paper).first }
      lock.synchronize { File.write(entry_path(root, id), JSON.pretty_generate(read_entry(root, id).merge(update))) }
    end
    ids.size
  end

  # fontspec, polyglossia and unicode-math need XeTeX or LuaTeX, Lua code
  # LuaTeX; anything else is compiled as pdflatex, as leeni would.
  ENGINES = [
    [/\\directlua|\\usepackage(?:\[[^\]]*\])?\{[^}]*\b(?:luacode|luatexbase|luaotfload)\b/, %w[lualatex l]],
    [/\\setmainfont|\\usepackage(?:\[[^\]]*\])?\{[^}]*\b(?:fontspec|polyglossia|unicode-math|xeCJK|mathspec)\b/,
     %w[xelatex x]]
  ].freeze

  def engine_for(paper)
    source = File.read(File.join(paper, 'main.tex'), mode: 'rb').force_encoding(Encoding::UTF_8).scrub
    ENGINES.find { |pattern, _| source.match?(pattern) }&.last || %w[pdflatex p]
  end

  # TeX's first errors from one run of the document's engine in a scratch copy.
  def tex_errors(paper)
    ProjectTmp.mktmpdir('texse-compile') do |work|
      FileUtils.cp_r(File.join(paper, '.'), work)
      Open3.capture2e('timeout', '60', engine_for(paper).first, '-interaction=nonstopmode', '-file-line-error', 'main.tex',
                      chdir: work, stdin_data: '')
      log = File.join(work, 'main.log')
      next ['no log written'] unless File.file?(log)

      text = File.read(log, mode: 'rb').force_encoding(Encoding::UTF_8).scrub
      text.lines.grep(TEX_ERROR).map(&:strip).grep_v(/warning/i).uniq.first(5)
    end
  end

  def failing?(entry)
    errors = Array(entry['tex_errors'])
    !errors.empty? && errors.none? { |error| error.match?(MISSING) }
  end

  # Documents that still fail and were never run, lowest question id first;
  # corpus/selected.json lists every id already given to a batch.
  def next_batch(root, limit)
    listed = File.join(corpus_dir(root), 'selected.json')
    taken = read_json(listed, [])
    ids = Dir.children(corpus_dir(root)).grep(/\A\d+\z/).sort_by(&:to_i)
    batch = ids.reject { |id| taken.include?(id) }.select { |id| failing?(read_entry(root, id)) }.first(limit)
    number = Dir.glob(File.join(corpus_dir(root), 'batch-*.json')).map { |f| f[/batch-(\d+)/, 1].to_i }.max.to_i + 1
    path = File.join(corpus_dir(root), "batch-#{number}.json")
    unless batch.empty?
      File.write(path, JSON.pretty_generate(batch))
      File.write(listed, JSON.pretty_generate(taken + batch))
    end
    { ids: batch, path: path }
  end

  # --- run -----------------------------------------------------------------

  def run(root, opts)
    batch = opts[:batch] || Dir.glob(File.join(corpus_dir(root), 'batch-*.json')).max_by { |f| f[/batch-(\d+)/, 1].to_i }
    abort 'texse_corpus: no batch; run prepare first' unless batch

    ids = JSON.parse(File.read(batch))
    results = []
    lock = Mutex.new
    each_parallel(ids, opts[:jobs]) do |id|
      row = run_document(root, id, opts)
      lock.synchronize { results << row }
    end
    results.sort_by! { |r| r[:id].to_i }
    output = opts[:output] || File.join(root, "run-#{File.basename(batch, '.json')}.json")
    File.write(output, JSON.pretty_generate(results))
    report(root, results, output)
  end

  def leeni(work, cache, opts, flag)
    MutateCorpus.leeni(work, 'main.tex', opts, cache, '-e', engine_for(work).last, '--timeout', '60', flag)
  end

  def run_document(root, id, opts)
    ProjectTmp.mktmpdir('texse') do |tmp|
      work = File.join(tmp, 'work')
      FileUtils.cp_r(File.join(corpus_dir(root), id, 'paper'), work)
      cache = File.join(tmp, 'cache')
      build = json_build(work, cache, opts)
      build_dir = build.dig(:data, 'build', 'build_dir')
      tex = build_dir && MutateCorpus.tex_first_error(build_dir)
      llm = build[:timed_out] ? nil : leeni(work, cache, opts, '-llm')
      CorpusCompare.remove_build_dir(build_dir)
      judge(id, build, tex, llm)
    end
  end

  def json_build(work, cache, opts)
    run = leeni(work, cache, opts, '--json')
    data = begin
      JSON.parse(run[:output][/\{.*\}/m].to_s)
    rescue JSON::ParserError
      nil
    end
    run.merge(data: data, crash: run[:output].match?(MutateCorpus::CRASH))
  end

  def judge(id, build, tex, llm)
    errors = MutateCorpus.errors_of(build)
    first = errors.first && { file: File.basename(errors.first['file'].to_s), line: errors.first['line'].to_i }
    flags = MutateCorpus.run_flags(build, llm, true) + MutateCorpus.fault_flags(tex, errors, first)
    flags << 'llm_disagree' if MutateCorpus.llm_disagrees?(llm, errors)
    flags << 'differs' if tex && first && [File.basename(tex[:file].to_s), tex[:line]] != first.values_at(:file, :line)
    { id: id, flags: flags, tex: tex, first: first, leeni_errors: errors.size,
      leeni: errors.first(4).map { |d| d.values_at('file', 'line', 'category', 'message').map { |v| v.to_s[0, 110] } } }
  end

  def report(root, results, output)
    puts "#{results.size} documents"
    puts "flags: #{results.flat_map { |r| r[:flags] }.tally.sort_by { |_, n| -n }.map { |f, n| "#{f}=#{n}" }.join(' ')}"
    results.reject { |r| r[:flags].empty? }.each do |row|
      tex = row[:tex] ? "#{File.basename(row[:tex][:file].to_s)}:#{row[:tex][:line]}" : '-'
      leeni = row[:first] ? "#{row[:first][:file]}:#{row[:first][:line]} #{row[:leeni].first&.at(2)}" : '-'
      puts "  #{row[:id].ljust(7)} #{row[:flags].join(',').ljust(14)} tex=#{tex.ljust(24)} leeni=#{leeni}  " \
           "#{read_entry(root, row[:id])['title'].to_s[0, 50]}"
    end
    puts "Results: #{output}"
  end

  def main(argv)
    command = argv.shift
    opts = parse(argv)
    abort HELP unless %w[fetch prepare run].include?(command) && argv.size == 1

    ProjectTmp.project = ToolSettings::PROJECT_NAME
    FileUtils.mkdir_p(corpus_dir(argv.first))
    send(command, argv.first, opts)
    0
  end
end

exit TexseCorpus.main(ARGV) if __FILE__ == $PROGRAM_NAME
